# From Supabase: Project Settings → API (use the Project URL and anon public key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — server-only. Never expose these to the browser (no NEXT_PUBLIC_ prefix).
# SUPABASE_SERVICE_ROLE_KEY is only needed by server routes that run without a user session (push notifications via src/lib/web-push-server.ts).
