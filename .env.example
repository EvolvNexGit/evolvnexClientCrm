# From Supabase: Project Settings → API (use the Project URL and anon public key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — server-only. Never expose these to the browser (no NEXT_PUBLIC_ prefix).
# COMMUNICATION_ENCRYPTION_KEY=64-char-hex-or-base64-32-byte-key
# WHATSAPP_API_VERSION=v21.0
# SUPABASE_SERVICE_ROLE_KEY is only needed for the Meta webhook (no user session).
